# Email delivery (https://resend.com). Without a key, development logs submissions instead of sending.
RESEND_API_KEY=
# Sender; the domain must be verified in Resend.
MAIL_FROM="Gamr website <website@gamr.africa>"

# Form routing: each enquiry goes to the inbox for its intent. These stay server-side and never reach the browser.
ROUTE_PUBLISHING=   # Pitch a game
ROUTE_BRANDS=       # Brand briefs, sponsorships
ROUTE_LAB=          # Learn with / partner with the Lab, hire talent
ROUTE_PRESS=        # Press enquiries
ROUTE_CAREERS=      # Careers
ROUTE_DEFAULT=info@gamr.africa   # Anything else, and the fallback for any unset route

# Canonical site URL used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://gamr.africa
